{
  "manifest_version": 3,
  "name": "UI Feedback Bridge",
  "version": "0.1.1",
  "description": "Point at a wrong UI element on your localhost dev page and send it to your coding agent. Runs only on localhost / 127.0.0.1.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
